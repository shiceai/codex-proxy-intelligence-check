{
  "manifestVersion": 2,
  "name": "intelligence-check",
  "displayName": "模型智力检测",
  "publisher": "shiceai",
  "version": "1.0.0",
  "description": "按账号手动运行推理题（预置糖果题，支持自定义），判断账号模型是否降智",
  "license": "Apache-2.0",
  "engines": {
    "codex-proxy-rs": ">=3.37.0, <4.0.0"
  },
  "main": "bin/plugin",
  "runtime": "trustedProcess",
  "contributes": {
    "management": {
      "version": 2
    },
    "maintenance": {}
  },
  "configurationSchema": {
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "resources": {
    "web/index.html": "text/html",
    "web/app.js": "text/javascript",
    "web/app.css": "text/css"
  },
  "state": [
    {
      "namespace": "questions",
      "schemaVersion": 1,
      "schema": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "required": [
                "id",
                "name",
                "prompt",
                "expected",
                "match",
                "enabled",
                "builtin"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                },
                "prompt": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "expected": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "match": {
                  "enum": [
                    "exact",
                    "contains"
                  ]
                },
                "enabled": {
                  "type": "boolean"
                },
                "builtin": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "maximumRecords": 1,
      "maximumBytes": 262144,
      "maximumValueBytes": 262144,
      "migratesFrom": []
    },
    {
      "namespace": "results",
      "schemaVersion": 1,
      "schema": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "required": [
                "id",
                "created_at_ms",
                "account_id",
                "account_label",
                "key_id",
                "key_name",
                "model",
                "response_model",
                "effort",
                "question_id",
                "question_name",
                "expected",
                "match",
                "verdict",
                "answer_excerpt",
                "error",
                "duration_ms",
                "input_tokens",
                "output_tokens",
                "reasoning_tokens",
                "request_id"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "created_at_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "account_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "account_label": {
                  "type": "string",
                  "maxLength": 512
                },
                "key_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "key_name": {
                  "type": "string",
                  "maxLength": 512
                },
                "model": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "response_model": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 256
                },
                "effort": {
                  "enum": [
                    "low",
                    "medium",
                    "high",
                    "xhigh",
                    null
                  ]
                },
                "question_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "question_name": {
                  "type": "string",
                  "maxLength": 40
                },
                "expected": {
                  "type": "string",
                  "maxLength": 200
                },
                "match": {
                  "enum": [
                    "exact",
                    "contains"
                  ]
                },
                "verdict": {
                  "enum": [
                    "normal",
                    "failed",
                    "error"
                  ]
                },
                "answer_excerpt": {
                  "type": "string",
                  "maxLength": 300
                },
                "error": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 300
                },
                "duration_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "input_tokens": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "output_tokens": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "reasoning_tokens": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "request_id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 256
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "maximumRecords": 2000,
      "maximumBytes": 16777216,
      "maximumValueBytes": 65536,
      "migratesFrom": []
    },
    {
      "namespace": "jobs",
      "schemaVersion": 1,
      "schema": {
        "type": "object",
        "required": [
          "id",
          "created_at_ms",
          "finished_at_ms",
          "key_id",
          "key_name",
          "model",
          "effort",
          "status",
          "tasks"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "created_at_ms": {
            "type": "integer",
            "minimum": 0
          },
          "finished_at_ms": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "key_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "key_name": {
            "type": "string",
            "maxLength": 512
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "effort": {
            "enum": [
              "low",
              "medium",
              "high",
              "xhigh",
              null
            ]
          },
          "status": {
            "enum": [
              "running",
              "stopping",
              "finished"
            ]
          },
          "tasks": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "object",
              "required": [
                "account_id",
                "question_id",
                "state",
                "result",
                "note"
              ],
              "properties": {
                "account_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "question_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "state": {
                  "enum": [
                    "pending",
                    "running",
                    "done",
                    "skipped",
                    "interrupted"
                  ]
                },
                "result": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "required": [
                    "id",
                    "verdict",
                    "created_at_ms",
                    "saved"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    },
                    "verdict": {
                      "enum": [
                        "normal",
                        "failed",
                        "error"
                      ]
                    },
                    "created_at_ms": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "saved": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false
                },
                "note": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 300
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "maximumRecords": 1,
      "maximumBytes": 262144,
      "maximumValueBytes": 262144,
      "migratesFrom": []
    }
  ]
}
